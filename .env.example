# Copie ce fichier en ".env" (sans ".example") et remplis les valeurs
# depuis ton projet Supabase : Project Settings > API Keys (anon key)
# et Project Settings > Integrations > Data API (Project URL).
#
# Le fichier ".env" ne doit JAMAIS être envoyé sur GitHub (il est
# listé dans .gitignore).

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
